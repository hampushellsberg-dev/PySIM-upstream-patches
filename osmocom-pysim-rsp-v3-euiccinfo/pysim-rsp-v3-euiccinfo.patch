index 0000000..428d7f4
--- /dev/null
+++ b/tests/unittests/test_esim_rsp.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+
+# (C) 2026 by Hampus Hellsberg <hampushellsberg@gmail.com>
